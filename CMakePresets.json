{
  "version": 3,
  "configurePresets": [
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja"
    },

    {
      "name": "visual-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/vs/build/${presetName}",
      "installDir": "${sourceDir}/out/vs/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl.exe",
        "CMAKE_CXX_COMPILER": "cl.exe"
      }
    },
    {
      "name": "visual-2026",
      "hidden": true,
      "inherits": "visual-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "visual-2022",
      "hidden": true,
      "inherits": "visual-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "visual-latest",
      "hidden": true,
      "inherits": "visual-2026"
    },

    {
      "name": "linux",
      "hidden": true,
      "inherits": "ninja-base",
      "cacheVariables": {
        "JAFG_TARGET_PLATFORM": "lnx",
        "JAFG_TARGET_ARCHITECTURE": "x86_64"
      }
    },

    {
      "name": "windows-base",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_PLATFORM": "win",
        "JAFG_TARGET_ARCHITECTURE": "x86_64"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": [
        "ninja-base",
        "windows-base"
      ]
    },
    {
      "name": "windows-msys",
        "hidden": true,
        "inherits": [
            "ninja-base",
            "windows-base"
        ],
        "cacheVariables": {
            "CMAKE_C_COMPILER": "clang.exe",
            "CMAKE_CXX_COMPILER": "clang++.exe"
        }
    },

    {
      "name": "shipping",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_CONFIG": "ship"
      }
    },
    {
      "name": "development",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_CONFIG": "dev"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_CONFIG": "dbg"
      }
    },
    {
      "name": "sanitized",
      "hidden": true,
      "cacheVariables": {
        "JAFG_DO_SANITIZED_BUILD": "ON"
      }
    },

    {
      "name": "editor",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_TYPE": "editor"
      }
    },
    {
      "name": "client",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_TYPE": "cl"
      }
    },
    {
      "name": "daemon",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_TYPE": "daemon"
      }
    },
    {
      "name": "test",
      "hidden": true,
      "cacheVariables": {
        "JAFG_TARGET_TYPE": "test"
      }
    },

    {
      "name": "lnx-x86_64--editor-ship",
      "displayName": "Linux | Editor-Shipping",
      "inherits": [
        "linux",
        "editor",
        "shipping"
      ]
    },
